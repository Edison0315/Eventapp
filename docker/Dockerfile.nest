# Multi-stage build for Nest (Nx)
# Build from monorepo root: docker build -f docker/Dockerfile.nest -t api .

# ---------- Stage 1: deps + build ----------
# Pin to specific patch version. Replace tag with @sha256:<digest> for full immutability.
FROM node:20.18-alpine3.20 AS build
WORKDIR /workspace

COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/api/project.json ./apps/api/
COPY libs ./libs
RUN npm ci --ignore-scripts

RUN npx nx build api --configuration=production --skip-nx-cache

# ---------- Stage 2: runtime ----------
FROM node:20.18-alpine3.20 AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Copy built artifact (nx emits a package.json with only runtime deps for the api)
COPY --from=build /workspace/dist/apps/api ./
# Install only the api's runtime deps, not the full monorepo deps
RUN npm install --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund \
  && npm cache clean --force \
  && rm -rf /root/.npm /tmp/*

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["node", "main.js"]
