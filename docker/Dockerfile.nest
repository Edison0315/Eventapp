# Multi-stage build for Nest (Nx)
# Build from monorepo root: docker build -f docker/Dockerfile.nest -t backend . 

# ---------- Stage 1: deps + build ----------
# Pin to specific patch version. Replace tag with @sha256:<digest> for full immutability.
FROM node:20.18-alpine3.20 AS build
WORKDIR /workspace

COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY libs ./libs
COPY apps ./apps
RUN npm ci --ignore-scripts

# Generate Prisma client for backend
RUN npx prisma generate --schema=./apps/backend/prisma/schema.prisma

RUN npx nx build backend --configuration=production --skip-nx-cache

# ---------- Stage 2: runtime ----------
FROM node:20.18-alpine3.20 AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Copy built artifact (nx emits a package.json with only runtime deps for the backend)
COPY --from=build /workspace/dist/apps/backend ./
# Install only the backend's runtime deps, not the full monorepo deps
RUN npm install --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund \
  && npm cache clean --force \
  && rm -rf /root/.npm /tmp/*

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- http://localhost:3000/backend/health || exit 1

CMD ["node", "main.js"]