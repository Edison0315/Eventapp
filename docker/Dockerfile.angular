# Multi-stage build for Angular (Nx)
# Build from monorepo root: docker build -f docker/Dockerfile.angular -t frontend .

# ---------- Stage 1: build -------------
# Pin to specific patch version. Replace tag with @sha256:<digest> for full immutability.
FROM node:20.18-alpine3.20 AS build
WORKDIR /workspace

# Cache deps
COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY libs ./libs
COPY apps ./apps
RUN npm ci --ignore-scripts

# Build the Angular app
ARG NX_BUILD_OPTIONS="--configuration=production"
RUN npx nx build frontend ${NX_BUILD_OPTIONS} --skip-nx-cache

# ---------- Stage 2: nginx (non-root) ----------
# Unprivileged nginx image runs as UID 101 and listens on 8080 by default.
FROM nginxinc/nginx-unprivileged:1.27.3-alpine
USER root
COPY nginx/angular.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/fuse/browser/. /usr/share/nginx/html/
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /etc/nginx/conf.d
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/ >/dev/null || exit 1